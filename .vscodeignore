# Exclude everything by default, then whitelist what we need
**/*

# WHITELIST: Include extension entry point
!dist/extension.js
!dist/extension.d.ts

# WHITELIST: Include server runtime files (compiled TypeScript)
!server/dist/**/*.js
!server/dist/**/*.d.ts

# WHITELIST: Include server dependencies
!server/node_modules/**
!server/package.json
!server/package-lock.json
!server/heap-limit.cjs
!server/run.mjs

# WHITELIST: Include Java indexer JAR (compiled with all dependencies)
!java-indexer/target/java-indexer-1.0.0.jar

# WHITELIST: Include required metadata files
!package.json
!README.md
!CHANGELOG.md
!LICENSE

# WHITELIST: Include icon
!media/**

# Exclude source maps to reduce size
**/*.map

# Exclude source TypeScript files
**/*.ts

# Exclude development files
.git
.gitignore
.vscode
.vscodeignore
**/.DS_Store
**/.idea

# Exclude build configuration
tsconfig.json
build.bat
build.ps1
pom.xml

# Exclude documentation
QUICKSTART.md
TESTING.md
DELIVERABLE.md
BUILD_VERIFICATION.md
PROJECT_STRUCTURE.md
PUBLISH*.md
MARKETPLACE_READY.md
GIT_PUSH_INSTRUCTIONS.md
INDEX.md
START_HERE.md
READY_TO_PUBLISH.md
EXTENSION_README.md
docs/

# Exclude examples and tests
example-config/
example-java-project/
test-*.json
test-*.js
test-*.bat

# Exclude Java source code (we only need the compiled JAR)
java-indexer/src/
java-indexer/target/classes/
java-indexer/target/maven-archiver/
java-indexer/target/maven-status/
java-indexer/target/generated-sources/
java-indexer/target/original-*.jar
