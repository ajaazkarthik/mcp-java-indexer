{
  "name": "mcp-java-indexer",
  "version": "2.2.3",
  "description": "IntelliJ-style Java code indexing MCP server with call-graph analysis",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node --max-old-space-size=4096 dist/index.js",
    "dev": "tsc && node --max-old-space-size=4096 dist/index.js"
  },
  "keywords": ["mcp", "java", "indexer", "call-graph"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "chokidar": "^3.5.3",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
