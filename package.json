{
  "name": "java-indexer-mcp",
  "displayName": "Java Indexer MCP",
  "description": "Complete Java code intelligence: indexing, AI explanations, test coverage, refactoring suggestions, code generation. 18 tools, zero setup!",
  "version": "2.8.13",
  "publisher": "ubanishathanvenkatesan",
  "author": {
    "name": "Ubanishath Anvenkatesan",
    "email": "ubanishathanvenkatesan@example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/ubanishathanvenkatesan/mcp-java-indexer",
  "repository": {
    "type": "git",
    "url": "https://github.com/ubanishathanvenkatesan/mcp-java-indexer.git"
  },
  "bugs": {
    "url": "https://github.com/ubanishathanvenkatesan/mcp-java-indexer/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "enabledApiProposal": [
    "lmApi"
  ],
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "java",
    "indexer",
    "mcp",
    "code-analysis",
    "call-graph",
    "symbol-search",
    "refactoring",
    "ai-assistant",
    "code-explanation",
    "semantic-search",
    "impact-analysis",
    "test-coverage",
    "code-generation",
    "code-quality"
  ],
  "galleryBanner": {
    "color": "#1E90FF",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "java-indexer-mcp",
        "label": "Java Indexer MCP"
      }
    ],
    "commands": [
      {
        "command": "java-indexer.index",
        "title": "Java Indexer: Index Project"
      },
      {
        "command": "java-indexer.findSymbol",
        "title": "Java Indexer: Find Symbol"
      },
      {
        "command": "java-indexer.findUsages",
        "title": "Java Indexer: Find Usages"
      },
      {
        "command": "java-indexer.callGraph",
        "title": "Java Indexer: Show Call Graph"
      }
    ],
    "configuration": {
      "title": "Java Indexer",
      "properties": {
        "javaIndexer.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically index Java projects on startup"
        },
        "javaIndexer.sourceRoots": {
          "type": "array",
          "default": [
            "src/main/java",
            "src"
          ],
          "description": "Default source root directories for indexing"
        },
        "javaIndexer.excludePatterns": {
          "type": "array",
          "default": [
            "**/target/**",
            "**/build/**",
            "**/.git/**",
            "**/node_modules/**"
          ],
          "description": "Patterns to exclude from indexing"
        },
        "javaIndexer.indexTimeout": {
          "type": "number",
          "default": 300000,
          "description": "Maximum time (ms) to wait for indexing to complete"
        }
      }
    }
  },
  "scripts": {
    "compile": "node build.js",
    "watch": "tsc -watch -p ./tsconfig.json",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "chokidar": "^3.5.3",
    "glob": "^10.3.10"
  }
}
